# Model provider key (NVIDIA NIM, OpenAI-compatible endpoint).
# Deliberately NOT prefixed with VITE_: it is read server-side by the dev proxy
# in vite.config.js and by api/ai.js when deployed, so it never reaches the
# browser bundle.
AI_API_KEY=your_nvidia_nim_api_key

# Required. Supabase backs sign-in and all persistence; the app shows a setup
# screen instead of starting without these.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

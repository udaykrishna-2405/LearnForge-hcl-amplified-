# Model provider key (NVIDIA NIM, OpenAI-compatible endpoint).
# Deliberately NOT prefixed with VITE_: it is read by the dev-server proxy in
# vite.config.js and never reaches the browser bundle.
AI_API_KEY=

# Optional. Without these the app runs entirely in memory.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
